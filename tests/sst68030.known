# Vectors of tests/data/sst68030 (the July corpus, permissive oracle) on which
# the fork deliberately does not follow the oracle. See tests/SstKnown.h for
# the rules: a listed vector that passes, or is missing, fails the gate.

# D23b (applied 2026-11-07) - FRESTORE of a version-$41 (68040) frame on a
# 68882: the fork takes the format error of the MC68881/MC68882 manual and
# of WinUAE's strict setting; these four were generated in its permissive
# setting, where a "horrible hack" accepts the frame. The corpus has no
# recipe to regenerate strict (TODO.md § Moteur › Socle).
fpu/identity seed=29 #75
fpu/off seed=29 #28
fpu/off seed=31 #83
fpu/tt seed=41 #166

# D23a (2026-11-16): MC68030UM-1989 Figure 10-45 uses format 2 and
# the F-line instruction address. The oracle instead emits format 3/EA.
# These tagged entries normalize only those frame bytes; the entire final
# state is still compared, and a stale oracle frame fails the gate.
@D23a 0017f4 | fpu/identity seed=11 #183
@D23a 0017f4 | fpu/identity seed=17 #2
@D23a 001ef4 | fpu/identity seed=29 #134
@D23a 0017f4 | fpu/identity seed=31 #105
@D23a 001ef4 | fpu/identity seed=31 #135
@D23a 0017f4 | fpu/off seed=11 #292
@D23a 0017f4 | fpu/off seed=31 #176
@D23a 0017f4 | fpu/off seed=31 #2
@D23a 0017f4 | fpu/off seed=31 #30
@D23a 0017f4 | fpu/tt seed=41 #63

