# Vectors of tests/data/sst68030_fpuraw on which the fork deliberately does not
# follow the oracle: one name per line, grouped by ruling
# (oracle/fuzz/disputes/NOTES.md). See tests/SstKnown.h for the rules: a
# listed vector that passes, or is missing, fails the gate.

# D26 - FMOVE.P FPn,(An)+{Dn} and -(An){Dn}. The fork steps An by the twelve
# bytes of a packed operand; the oracle's size table holds 0 for the dynamic
# k-factor format.
fpuraw/identity seed=722 #237
fpuraw/identity seed=722 #646
fpuraw/identity seed=722 #797
fpuraw/identity seed=722 #1742
fpuraw/identity seed=722 #1980
fpuraw/off seed=721 #41
fpuraw/off seed=721 #1634
fpuraw/off seed=721 #1649
fpuraw/off seed=721 #1901
fpuraw/off seed=721 #1985
fpuraw/tt seed=723 #18
fpuraw/tt seed=723 #222
fpuraw/tt seed=723 #365
fpuraw/tt seed=723 #474
fpuraw/tt seed=723 #1641

# D27 - FMOVE(M) control registers to a PC-relative destination. Both refuse
# the instruction; the oracle evaluates the EA first (a page marked Used, or a
# bus fault from the walk).
fpuraw/identity seed=722 #837
fpuraw/tt seed=723 #1982

# D28 - FBcc / FDBcc taken to an odd address. The fork takes the address error
# inside the branch, as it does for Bcc; the oracle only sets the PC and never
