From 1902c1c3e2cf05ebb45871a60231c35da8451c47 Mon Sep 17 00:00:00 2001
From: VERHILLE Arnaud <gist974@gmail.com>
Date: Tue, 24 Nov 2026 00:30:37 +0400
Subject: [PATCH 07/17] Halt on a double bus fault during reset or a trace
 exception

MC68030UM 8.1.1: "if bus error or address error occur during the exception
processing sequence for a reset a double bus fault occurs. The processor
halts", and 8.1.2 for a bus error while an exception is processed.
reset() fetched the vectors and execute() stacked the trace frame outside
any handler, so a BusError thrown by the host escaped to the caller instead
of halting the CPU. Seen on a host whose reset vectors are unmapped, and on
a Quadra 605 whose supervisor stack pointer had been corrupted.
---
 Moira/Moira.cpp | 26 +++++++++++++++++++-------
 1 file changed, 19 insertions(+), 7 deletions(-)

diff --git a/Moira/Moira.cpp b/Moira/Moira.cpp
index b9ca9bc..f1371b5 100644
--- a/Moira/Moira.cpp
+++ b/Moira/Moira.cpp
@@ -157,13 +157,22 @@ Moira::reset()
     fpu.reset();
     completed.armed = false;
 
-    switch (cpuModel) {
+    // A bus or address error while the reset vectors are fetched is a double
+    // bus fault: the processor halts (MC68030UM 8.1.1)
+    try {
 
-        case CPUModel::M68000: reset<Core::C68000>(); break;
-        case CPUModel::M68010: reset<Core::C68010>(); break;
-        
-        default:
-            reset<Core::C68020>();
+        switch (cpuModel) {
+
+            case CPUModel::M68000: reset<Core::C68000>(); break;
+            case CPUModel::M68010: reset<Core::C68010>(); break;
+
+            default:
+                reset<Core::C68020>();
+        }
+
+    } catch (const std::exception &) {
+
+        halt();
     }
 }
 
@@ -214,7 +223,10 @@ Moira::execute()
 
             // Process pending trace exception (if any)
             if (flags & TRACE_EXC) {
-                execException(M68kException::TRACE);
+
+                // A fault while the trace frame is stacked is a double bus fault
+                // (MC68030UM 8.1.2): the processor halts
+                try { execException(M68kException::TRACE); } catch (const std::exception &) { halt(); }
                 goto done;
             }
 
