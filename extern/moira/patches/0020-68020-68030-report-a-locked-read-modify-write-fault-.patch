-        writeOp<C, M, S>(dst, ea, data);
+        try { writeOp<C, M, S>(dst, ea, data); } catch (BusError &e) { lockedBusError<C>(e); throw; }
         prefetch<C, POLL>();
         SYNC(2);
     }
