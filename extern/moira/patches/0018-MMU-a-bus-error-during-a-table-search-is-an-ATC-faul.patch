From fbfcc295966db6fdf76a59c8e4ac70817c6937af Mon Sep 17 00:00:00 2001
From: VERHILLE Arnaud <gist974@gmail.com>
Date: Thu, 26 Nov 2026 07:32:15 +0400
Subject: [PATCH 18/19] MMU: a bus error during a table search is an ATC fault
 on the retried access

MC68040UM 8.4.6.2: the ATC bit of the SSW "is set for an ATC fault due to
a nonresident entry (bus error during table search or invalid descriptor
encountered)". 8.2.1: when "the assertion of the TEA signal during a bus
cycle used to access the translation tables" prevents a valid translation,
"an internal access fault occurs when the aborted access is retried"; 3.5:
an access that hits an ATC entry whose table search met an access error is
aborted. MC68030UM 9.4: the B bit of an ATC entry "is set for an entry if a
bus error, an invalid descriptor, a supervisor violation, or a limit
violation is encountered during the table search", and "the bus error
exception is taken on the retry"; 8.1.2 says the same.

A host BusError raised by a descriptor read escaped walk() and translate(),
and the access took a physical bus error on the descriptor. On the 68040
the SSW lacked ATC: with the page descriptor of logical $10000100 on a
/BERR hole, MOVE.L (A0),D0 stacked SSW $0105 instead of $0505 and MOVE.L
D0,(A0) $0005 instead of $0405. On the 68030 the frame carried the
descriptor's physical address ($00080000) instead of the logical address
of the access ($40000000), and no ATC entry was created, so a level-0 PTEST
afterwards found none (MMUSR $0400 instead of $8400).

translate() now ends the walk on a bus error the way it ends it on an
invalid descriptor: the 68040 inserts a nonresident entry, the 68030 an
entry with B set, and the access faults on that entry with the logical
address. PTEST and PLOAD, which walk the tables themselves, are unchanged.

A frame supplied by the host (BusError::custom) is not absorbed by the
search: it is thrown on to the access, unmodified.
---
 Moira/MMU/MMU030.cpp | 18 ++++++++++++++++--
 Moira/MMU/MMU040.cpp | 14 ++++++++++++--
 2 files changed, 28 insertions(+), 4 deletions(-)

diff --git a/Moira/MMU/MMU030.cpp b/Moira/MMU/MMU030.cpp
index dc9b2a8..4129813 100644
--- a/Moira/MMU/MMU030.cpp
+++ b/Moira/MMU/MMU030.cpp
@@ -216,8 +216,22 @@ MMU030::translate(u32 addr, u8 fc, bool write, bool *ci)
     if (!line) {
 
         MmuContext context;
-        u32 physAddr = walk(addr, fc, write, context);
-        line = atcInsert(addr, fc, physAddr, context.status(), context.ci);
+        u32 physAddr = 0, status;
+
+        // A bus error during the table search sets the B bit of the entry, and
+        // the access takes the exception on its retry.
+        // [B] MC68030UM § 9.4 — B "is set for an entry if a bus error, an
+        //     invalid descriptor, a supervisor violation, or a limit violation
+        //     is encountered during the table search"; § 8.1.2.
+        try {
+            physAddr = walk(addr, fc, write, context);
+            status = context.status();
+        } catch (const BusError &e) {
+            if (e.custom) throw;    // a frame supplied by the host is passed on
+            status = MMUSR_BUS_ERROR | MMUSR_INVALID;
+            context.ci = false;
+        }
+        line = atcInsert(addr, fc, physAddr, status, context.ci);
     }
     
     auto &e = atc[*line];
diff --git a/Moira/MMU/MMU040.cpp b/Moira/MMU/MMU040.cpp
index 0d46883..86f465a 100644
--- a/Moira/MMU/MMU040.cpp
+++ b/Moira/MMU/MMU040.cpp
@@ -130,8 +130,18 @@ MMU040::translate(u32 addr, u8 fc, bool write, bool *ci)
     // On a cache miss, walk the tables and update the cache
     if (!line) {
 
-        u32 status;
-        u32 physAddr = walk(addr, super, write, status);
+        u32 status = 0, physAddr = 0;
+
+        // A bus error during the table search ends it like an invalid
+        // descriptor: the entry is not resident, and the access takes an ATC
+        // fault instead of a bus error on the descriptor.
+        // [B] MC68040UM § 8.4.6.2 — ATC "is set for an ATC fault due to a
+        //     nonresident entry (bus error during table search or invalid
+        //     descriptor encountered)"; § 3.5, § 8.2.1: the access faults when
+        //     it is retried.
+        // A frame supplied by the host is passed on.
+        try { physAddr = walk(addr, super, write, status); }
+        catch (const BusError &e) { if (e.custom) throw; status = 0; }
         line = atcInsert(addr, fc, physAddr, status);
     }
 
