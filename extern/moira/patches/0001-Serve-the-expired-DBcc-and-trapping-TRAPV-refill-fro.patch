From 4ede1c09b6b1f0bd87e329989d1e411f5bfd2bf8 Mon Sep 17 00:00:00 2001
From: VERHILLE Arnaud <gist974@gmail.com>
Date: Tue, 24 Nov 2026 13:52:56 +0400
Subject: [PATCH 01/16] Serve the expired DBcc and trapping TRAPV refill from
 the instruction cache

An expired DBcc and a trapping TRAPV read a program word they discard,
like MOVE to SR/CCR. With an emulated instruction cache, that read now goes
through readStatusRefill() as well, so a cached word costs no bus access.

In the cache case, MC68020UM 8.2.15 gives DBcc (cc = False, Count
Expired) 10(0/0/0) and 8.2.17 gives TRAPV (Trap) 25(1/0/5): no prefetch
(instruction access). MC68030UM 11.6.15 and 11.6.17 give 10(0/0/0) and
22(1/0/5) for the I-cache case. Without an emulated cache the read stays a
bus access, as before.
---
 Moira/MoiraDataflow.h | 2 +-
 Moira/MoiraExec_cpp.h | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/Moira/MoiraDataflow.h b/Moira/MoiraDataflow.h
index 9bb4dc1..b694bda 100644
--- a/Moira/MoiraDataflow.h
+++ b/Moira/MoiraDataflow.h
@@ -114,7 +114,7 @@ template <Core C, Size S, Flags F = 0> u32 readDataCache(u32 addr);
 template <Core C, Flags F = 0> u16 readInstr(u32 addr);
 
 
-// Reads the instruction word discarded by MOVE to SR or CCR.
+// Reads the instruction word discarded by MOVE to SR or CCR, an expired DBcc or a trapping TRAPV.
 template <Core C> void readStatusRefill();
 
 // Writes an operand to memory (without or with address error checking)
diff --git a/Moira/MoiraExec_cpp.h b/Moira/MoiraExec_cpp.h
index a09ebc5..778e390 100644
--- a/Moira/MoiraExec_cpp.h
+++ b/Moira/MoiraExec_cpp.h
@@ -2464,7 +2464,7 @@ Moira::execDbcc(u16 opcode)
             } else {
 
                 writeD<Word>(dn, U32_SUB(readD<Word>(dn), 1));
-                (void)read<C, AddrSpace::PROG, Word>(reg.pc + 2);
+                readStatusRefill<C>();
                 CYCLES_68020(10);
                 fullPrefetchAt<C, POLL>(reg.pc + 2);
             }
@@ -5511,7 +5511,7 @@ Moira::execTrapv(u16 opcode)
 
         } else {
 
-            (void)read<C, AddrSpace::PROG, Word>(reg.pc + 2);
+            readStatusRefill<C>();
             SYNC(2);
         }
 
