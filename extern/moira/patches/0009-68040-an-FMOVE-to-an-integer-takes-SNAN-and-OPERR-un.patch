From b7adfdf2a45810976ceb222f368d2020cf2d3678 Mon Sep 17 00:00:00 2001
From: VERHILLE Arnaud <gist974@gmail.com>
Date: Tue, 24 Nov 2026 00:56:58 +0400
Subject: [PATCH 09/16] 68040: an FMOVE to an integer takes SNAN and OPERR
 unconditionally

MC68040UM 9.7.2.2 and 9.7.3.2: when an FMOVE to byte, word or long word
meets an SNAN, or a source too large, infinite or NaN, "the processor
immediately takes a post-instruction exception", whether the exception is
enabled or not; the FPSP then completes the instruction. The move took the
exception only when FPCR enabled it. trapVector() now accepts a mask of
nonmaskable conditions, which the 68040 passes for integer destinations.
---
 Moira/FPU/FPU.cpp        | 4 ++--
 Moira/FPU/FPU.h          | 5 +++--
 Moira/MoiraExecFPU_cpp.h | 9 ++++++++-
 3 files changed, 13 insertions(+), 5 deletions(-)

diff --git a/Moira/FPU/FPU.cpp b/Moira/FPU/FPU.cpp
index b119c73..453f2d8 100644
--- a/Moira/FPU/FPU.cpp
+++ b/Moira/FPU/FPU.cpp
@@ -38,14 +38,14 @@ FPU::tag040(const MFloat80 &v)
 }
 
 u16
-FPU::trapVector() const
+FPU::trapVector(u32 nonmaskable) const
 {
     /* The exceptions are prioritized as follows (MC68881/MC68882UM, 6.1):
      * BSUN (48), SNAN (54), OPERR (52), OVFL (53), UNFL (51), DZ (50), INEX1 and INEX2 (49)
      */
     static constexpr u16 vectors[8] = { 49, 49, 50, 51, 53, 52, 54, 48 };
 
-    u32 bits = (fpsr & fpcr & FPSR::EXC_MASK) >> 8;
+    u32 bits = (fpsr & (fpcr | nonmaskable) & FPSR::EXC_MASK) >> 8;
     for (int i = 7; i >= 0; i--) if (bits & (1 << i)) return vectors[i];
     return 0;
 }
diff --git a/Moira/FPU/FPU.h b/Moira/FPU/FPU.h
index 6fd8360..4b67251 100644
--- a/Moira/FPU/FPU.h
+++ b/Moira/FPU/FPU.h
@@ -252,8 +252,9 @@ public:
     bool isEnabled(u32 exceptionBit) const { return fpcr & exceptionBit; }
 
     /// Returns the vector of the exception with the highest priority that is
-    /// set in the exception status byte and enabled in FPCR (0 = none)
-    u16 trapVector() const;
+    /// set in the exception status byte and enabled in FPCR (0 = none). The
+    /// bits in 'nonmaskable' are taken whether they are enabled or not.
+    u16 trapVector(u32 nonmaskable = 0) const;
 
     /// Checks if an exception that is set and enabled prevents the result from
     /// being stored (SNAN, OPERR and DZ, MC68881/MC68882UM, 6.1)
diff --git a/Moira/MoiraExecFPU_cpp.h b/Moira/MoiraExecFPU_cpp.h
index f418e67..294cc7b 100644
--- a/Moira/MoiraExecFPU_cpp.h
+++ b/Moira/MoiraExecFPU_cpp.h
@@ -931,7 +931,14 @@ Moira::execFMove(u16 opcode)
         // The 68040 takes an enabled exception right after a move to memory or to
         // a data register (post-instruction exception). The 68881 and 68882 report
         // it when the next FPU instruction starts, like all other exceptions.
-        if (auto vector = fpu.trapVector(); vector && hasInternalFPU()) {
+        // On the 68040, a move to a byte, word or long word that raises SNAN or
+        // OPERR takes the exception even if it is disabled (MC68040UM 9.7.2.2,
+        // 9.7.3.2: a nonmaskable post-instruction exception, taken immediately).
+        auto integer = FpuFormat(fmt) == FpuFormat::BYTE || FpuFormat(fmt) == FpuFormat::WORD ||
+                       FpuFormat(fmt) == FpuFormat::LONG;
+        u32 nonmaskable = hasInternalFPU() && integer ? FPEXP::SIG_NAN | FPEXP::OPERR : 0;
+
+        if (auto vector = fpu.trapVector(nonmaskable); vector && hasInternalFPU()) {
 
             execFpuTrap<C>(vector, true, ea);
             FINALIZE
