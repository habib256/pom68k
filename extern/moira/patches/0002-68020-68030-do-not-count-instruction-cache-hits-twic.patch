From 1437fdbedc02ac532d72eb5b8bb0353edae65ef5 Mon Sep 17 00:00:00 2001
From: VERHILLE Arnaud <gist974@gmail.com>
Date: Mon, 23 Nov 2026 20:44:41 +0400
Subject: [PATCH 02/17] 68020/68030: do not count instruction cache hits twice

The 68020 tables are the cache-only column of MC68020UM 8.2 ("the
instruction is in the cache but has no overlap"), and readInstr() also
subtracted 2 clocks per hit. A cached 8 x NOP + DBF loop cost 4.5 clocks per
iteration; the manual gives 22 (NOP 2, DBcc not expired 6). A hit or latch
fetch now adds 0 and a bus fetch adds 2 from a 32-bit port (6 from a
narrower one), which gives 22 warm and 32 with the cache off (manual worst
case 33).
---
 Moira/MoiraDataflow_cpp.h | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/Moira/MoiraDataflow_cpp.h b/Moira/MoiraDataflow_cpp.h
index 70e1b55..e5e983a 100644
--- a/Moira/MoiraDataflow_cpp.h
+++ b/Moira/MoiraDataflow_cpp.h
@@ -884,7 +884,18 @@ Moira::readInstr(u32 addr)
             completeBusError<Word, false>(e);
             throw;
         }
-        budget.penalty += busAccess ? (portSize(dsack(phys)) == 4 ? 0 : 4) : -2;
+        // The 68020 timing tables are the manual's cache-only case: the
+        // instruction is in the cache, with no instruction access and no
+        // overlap (MC68020UM 8.2). A fetch served by the cache or the latch
+        // therefore adds nothing; one that makes a bus cycle adds 2 clocks
+        // from a 32-bit port and 6 from a narrower one. Subtracting 2 per hit
+        // counted the cache twice: a cached 8 x NOP + DBF loop cost 4.5 clocks
+        // instead of 22. Without an emulated cache (68040) the charge is unchanged.
+        if (iCache.emulated) {
+            budget.penalty += busAccess ? (portSize(dsack(phys)) == 4 ? 2 : 6) : 0;
+        } else {
+            budget.penalty += portSize(dsack(phys)) == 4 ? 0 : 4;
+        }
 
         return result;
 
