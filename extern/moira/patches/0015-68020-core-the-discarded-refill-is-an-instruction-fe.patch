From 4656b4342b89b952e78d03edac1c2e09617ca504 Mon Sep 17 00:00:00 2001
From: VERHILLE Arnaud <gist974@gmail.com>
Date: Tue, 24 Nov 2026 16:10:16 +0400
Subject: [PATCH 15/15] 68020 core: the discarded refill is an instruction
 fetch without a cache too

readStatusRefill() sent the discarded program word through readInstr() only
when the instruction cache is emulated. Without one, it used a plain program
read, which skips what readInstr() charges for every other instruction word:
the narrow-port penalty of a 16-bit dsack().

The refill now goes through readInstr() on every 68020-core model, so the
word costs what any other fetched word costs on that bus.
---
 Moira/MoiraDataflow_cpp.h | 6 ++----
 1 file changed, 2 insertions(+), 4 deletions(-)

diff --git a/Moira/MoiraDataflow_cpp.h b/Moira/MoiraDataflow_cpp.h
index f9ebea9..27cb6c3 100644
--- a/Moira/MoiraDataflow_cpp.h
+++ b/Moira/MoiraDataflow_cpp.h
@@ -868,10 +868,8 @@ Moira::readStatusRefill()
 {
     u32 addr = C == Core::C68000 ? reg.pc : reg.pc + 2;
     if constexpr (C == Core::C68020) {
-        if (iCache.emulated) {
-            (void)readInstr<C>(addr);
-            return;
-        }
+        (void)readInstr<C>(addr);
+        return;
     }
     (void)read<C, AddrSpace::PROG, Word>(addr);
 }
