From 19a461f80638efa640df22163d40ca21099e7537 Mon Sep 17 00:00:00 2001
From: VERHILLE Arnaud <gist974@gmail.com>
Date: Mon, 23 Nov 2026 20:44:50 +0400
Subject: [PATCH 03/17] 68020/68030: serve discarded program reads from the
 instruction cache

MOVE to SR/CCR, ANDI/ORI/EORI to SR/CCR, an expired DBcc and TRAPV read a
program word they discard. They went to the bus even when the word was
cached: a cached MOVE #$2700,SR + DBF loop made one bus read per iteration,
where MC68020UM 8.2.7 gives MOVE EA,SR 8(0/0/0) in the cache-only case, i.e.
no instruction access. On the 68020 core the read is now an instruction
access through readInstr(); the 68000 and 68010 are unchanged.
---
 Moira/MoiraDataflow.h     |  5 +++++
 Moira/MoiraDataflow_cpp.h | 10 ++++++++++
 Moira/MoiraExec_cpp.h     | 16 ++++++++--------
 3 files changed, 23 insertions(+), 8 deletions(-)

diff --git a/Moira/MoiraDataflow.h b/Moira/MoiraDataflow.h
index 379352a..7862e60 100644
--- a/Moira/MoiraDataflow.h
+++ b/Moira/MoiraDataflow.h
@@ -113,6 +113,11 @@ template <Core C, Size S, Flags F = 0> u32 readDataCache(u32 addr);
 // Reads an instruction word, either from memory or the instruction cache
 template <Core C, Flags F = 0> u16 readInstr(u32 addr);
 
+// Performs a program read whose word an instruction discards (MOVE to SR/CCR,
+// ANDI/ORI/EORI to SR/CCR, DBcc on expiry, TRAPV). On the 68020 core it is an
+// instruction access that the cache can serve.
+template <Core C> void dummyProgRead(u32 addr);
+
 
 // Writes an operand to memory (without or with address error checking)
 template <Core C, Mode M, Size S, Flags F = 0> void writeM(u32 addr, u32 val);
diff --git a/Moira/MoiraDataflow_cpp.h b/Moira/MoiraDataflow_cpp.h
index e5e983a..8197ffe 100644
--- a/Moira/MoiraDataflow_cpp.h
+++ b/Moira/MoiraDataflow_cpp.h
@@ -841,6 +841,16 @@ catch (BusError &e)
 }
 
 
+template <Core C> void
+Moira::dummyProgRead(u32 addr)
+{
+    if constexpr (C == Core::C68020) {
+        (void)readInstr<C>(addr);
+    } else {
+        (void)read<C, AddrSpace::PROG, Word>(addr);
+    }
+}
+
 template <Core C, Flags F> u16
 Moira::readInstr(u32 addr)
 {
diff --git a/Moira/MoiraExec_cpp.h b/Moira/MoiraExec_cpp.h
index 69c17ef..36f7359 100644
--- a/Moira/MoiraExec_cpp.h
+++ b/Moira/MoiraExec_cpp.h
@@ -929,7 +929,7 @@ Moira::execAndiccr(u16 opcode)
         u8  dst = getCCR();
         setCCR(u8(logic<C, I, S>(src, dst)));
         SYNC(8);
-        (void)read<C, AddrSpace::PROG, Word>(reg.pc);
+        dummyProgRead<C>(reg.pc);
 
     } else {
 
@@ -967,7 +967,7 @@ Moira::execAndisr(u16 opcode)
     setSR((u16)result);
 
     if constexpr (C == Core::C68000) {
-        (void)read<C, AddrSpace::PROG, Word>(reg.pc);
+        dummyProgRead<C>(reg.pc);
     } else {
         (void)read<C, AddrSpace::DATA, Word>(reg.pc + 2);
     }
@@ -2314,7 +2314,7 @@ Moira::execDbcc(u16 opcode)
             } else {
 
                 writeD<Word>(dn, U32_SUB(readD<Word>(dn), 1));
-                (void)read<C, AddrSpace::PROG, Word>(reg.pc + 2);
+                dummyProgRead<C>(reg.pc + 2);
                 CYCLES_68000(14);
                 fullPrefetchAt<C, POLL>(reg.pc + 2);
             }
@@ -2414,7 +2414,7 @@ Moira::execDbcc(u16 opcode)
 
                 } else {
 
-                    (void)read<C, AddrSpace::PROG, Word>(reg.pc + 2);
+                    dummyProgRead<C>(reg.pc + 2);
                     SYNC((compat == Compatibility::MUSASHI) ? 4 : 2);
                     CYCLES_68010(8);
 
@@ -2464,7 +2464,7 @@ Moira::execDbcc(u16 opcode)
             } else {
 
                 writeD<Word>(dn, U32_SUB(readD<Word>(dn), 1));
-                (void)read<C, AddrSpace::PROG, Word>(reg.pc + 2);
+                dummyProgRead<C>(reg.pc + 2);
                 CYCLES_68020(10);
                 fullPrefetchAt<C, POLL>(reg.pc + 2);
             }
@@ -4026,7 +4026,7 @@ Moira::execMoveToCcr(u16 opcode)
     SYNC(4);
     setCCR((u8)data);
 
-    (void)read<C, AddrSpace::PROG, Word>(C == Core::C68000 ? reg.pc : reg.pc + 2);
+    dummyProgRead<C>(C == Core::C68000 ? reg.pc : reg.pc + 2);
     prefetch<C, POLL>();
 
     //           00  10  20        00  10  20        00  10  20
@@ -4126,7 +4126,7 @@ Moira::execMoveToSr(u16 opcode)
     SYNC(4);
     setSR((u16)data);
 
-    (void)read<C, AddrSpace::PROG, Word>(C == Core::C68000 ? reg.pc : reg.pc + 2);
+    dummyProgRead<C>(C == Core::C68000 ? reg.pc : reg.pc + 2);
     prefetch<C, POLL>();
 
     //           00  10  20        00  10  20        00  10  20
@@ -5511,7 +5511,7 @@ Moira::execTrapv(u16 opcode)
 
         } else {
 
-            (void)read<C, AddrSpace::PROG, Word>(reg.pc + 2);
+            dummyProgRead<C>(reg.pc + 2);
             SYNC(2);
         }
 
