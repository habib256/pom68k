From 3104717d635de2a7adcf0a277ffd280a786dbb93 Mon Sep 17 00:00:00 2001
From: VERHILLE Arnaud <gist974@gmail.com>
Date: Mon, 23 Nov 2026 20:47:41 +0400
Subject: [PATCH 03/16] 68040: FSAVE stores the unimplemented instruction state
 frame

After an unimplemented floating-point instruction the 68040 takes vector 11
with a format $2 frame, and the FPSP's handler then executes FSAVE. MC68040UM
9.6.1: "a 26-word unimplemented instruction state frame is created"
(version $41, size $30, Figure 9-10 d). FSAVE returned a null frame, so the
FPSP could not read its operands. execFUnimplemented() now keeps the fields
Table 9-16 defines for this case (CMDREG1B, ETEMP and STAG, FPTEMP and DTAG,
E1 = 1, T = 0) and FSAVE writes them. The UNIMP frame size becomes 48 and its
format word on the 68040 carries version $41.
---
 Moira/FPU/FPU.cpp        | 16 ++++++++++++-
 Moira/FPU/FPU.h          | 17 ++++++++++++++
 Moira/MoiraExecFPU_cpp.h | 50 ++++++++++++++++++++++++++++++++++------
 3 files changed, 75 insertions(+), 8 deletions(-)

diff --git a/Moira/FPU/FPU.cpp b/Moira/FPU/FPU.cpp
index 6f04086..699521a 100644
--- a/Moira/FPU/FPU.cpp
+++ b/Moira/FPU/FPU.cpp
@@ -24,6 +24,17 @@ FPU::reset()
 
     resetState = true;
     pendingTrap = 0;
+    unimp.valid = false;
+}
+
+u8
+FPU::tag040(const MFloat80 &v)
+{
+    if (v.isZero()) return 1;
+    if (v.isNaN()) return 3;
+    if (v.isInfinite()) return 2;
+    if (!v.integerBit()) return 4;
+    return 0;
 }
 
 u16
@@ -903,7 +914,8 @@ FPU::stateFrameSize(FpuFrameType type) const
 
         case FpuFrameType::UNIMP:
 
-            return model == FPUModel::M68040 ? 44 : 0;
+            // 26 words including the format word (MC68040UM 9.6.1, Figure 9-10)
+            return model == FPUModel::M68040 ? 48 : 0;
 
         case FpuFrameType::BUSY:
 
@@ -954,6 +966,8 @@ FPU::computeFormatWord(FpuFrameType type) const
         case FpuFrameType::UNIMP:
         case FpuFrameType::BUSY:
 
+            // The 68040 frames carry version $41 like the idle frame (Figure 9-10)
+            if (model == FPUModel::M68040) return 0x41000000 | u32(stateFrameSize(type)) << 16;
             return 0x1F000000 | u32(stateFrameSize(type)) << 16;
 
         default:
diff --git a/Moira/FPU/FPU.h b/Moira/FPU/FPU.h
index 0c1ad9c..6fd8360 100644
--- a/Moira/FPU/FPU.h
+++ b/Moira/FPU/FPU.h
@@ -134,6 +134,23 @@ public:
     /// Vector of an arithmetic exception that is taken when the next FPU instruction starts (0 = none)
     u16 pendingTrap = 0;
 
+    /// Operands of an instruction the 68040 left to the FPSP. A following FSAVE
+    /// stores them in an unimplemented instruction state frame (MC68040UM 9.6.1).
+    struct {
+
+        bool valid = false;
+        u16 cmdreg1b = 0;       ///< Command word of the instruction
+        u8 stag = 0;            ///< Tag of the source operand
+        u8 dtag = 0;            ///< Tag of the destination operand
+        MFloat80 etemp;         ///< Source operand, converted to extended precision
+        MFloat80 fptemp;        ///< Destination operand
+
+    } unimp;
+
+    /// Tag of an operand in a 68040 state frame (MC68040UM 9.8: 0 normalized,
+    /// 1 zero, 2 infinity, 3 NaN, 4 extended denormalized or unnormalized)
+    static u8 tag040(const MFloat80 &v);
+
 
     //
     // Constructing
diff --git a/Moira/MoiraExecFPU_cpp.h b/Moira/MoiraExecFPU_cpp.h
index c0bd093..63eb2de 100644
--- a/Moira/MoiraExecFPU_cpp.h
+++ b/Moira/MoiraExecFPU_cpp.h
@@ -679,16 +679,37 @@ Moira::execFSave(u16 opcode)
     // The frame carries no exception state. A pending arithmetic exception is discarded (as in UAE).
     fpu.pendingTrap = 0;
 
-    // Frame to be written: A NULL frame if the FPU is in reset state, an IDLE frame otherwise
-    bool null = fpu.inResetState();
-    u32 fmt   = null ? 0 : fpu.computeFormatWord(FpuFrameType::IDLE);
-    u32 size  = null ? 4 : 4 + fpu.stateFrameSize(FpuFrameType::IDLE);
+    // Frame to be written: A NULL frame if the FPU is in reset state, an UNIMP frame
+    // after an instruction the 68040 left to the FPSP, an IDLE frame otherwise
+    bool null  = fpu.inResetState();
+    bool unimp = !null && hasInternalFPU() && fpu.unimp.valid;
+    auto type  = unimp ? FpuFrameType::UNIMP : FpuFrameType::IDLE;
+    u32 fmt    = null ? 0 : fpu.computeFormatWord(type);
+    u32 size   = null ? 4 : 4 + fpu.stateFrameSize(type);
 
     u32 ea;
     if constexpr (M == Mode::PD) ea = U32_SUB(readA(n), size); else ea = computeEA<C, M, Long>(n);
 
+    // The longwords of the frame (MC68040UM Figure 9-10 d, Table 9-16)
+    u32 frame[13] = { };
+    if (unimp) {
+
+        auto &u = fpu.unimp;
+        frame[3]  = u32(u.stag) << 29;                          // STAG
+        frame[4]  = u32(u.cmdreg1b) << 16;                      // CMDREG1B
+        frame[5]  = u32(u.dtag) << 29;                          // DTAG
+        frame[6]  = 1 << 26;                                    // E1 = 1, T = 0
+        frame[7]  = u32(u.fptemp.signExp()) << 16;              // FPTEMP
+        frame[8]  = u32(u.fptemp.mantissa() >> 32);
+        frame[9]  = u32(u.fptemp.mantissa());
+        frame[10] = u32(u.etemp.signExp()) << 16;               // ETEMP
+        frame[11] = u32(u.etemp.mantissa() >> 32);
+        frame[12] = u32(u.etemp.mantissa());
+        u.valid = false;
+    }
+
     writeM<C, M, Long>(ea, fmt);
-    for (u32 i = 4; i < size; i += 4) writeM<C, M, Long>(U32_ADD(ea, i), 0);
+    for (u32 i = 4; i < size; i += 4) writeM<C, M, Long>(U32_ADD(ea, i), i / 4 < 13 ? frame[i / 4] : 0);
 
     if constexpr (M == Mode::PD) writeA(n, ea);
 
@@ -1106,6 +1127,8 @@ Moira::execFUnimplemented(int n, FpuFormat fmt, bool rm)
      * instruction and the effective address (0 for register operands, as in UAE).
      */
     u32 ea = 0;
+    u16 ext = queue.irc;
+    MFloat80 src = fpu.fpr[(ext >> 10) & 7];
 
     readI<C, Word>();
     fpu.setFPIAR(getPC0());
@@ -1115,14 +1138,27 @@ Moira::execFUnimplemented(int n, FpuFormat fmt, bool rm)
         if constexpr (isMemMode(M)) {
 
             ea = computeFpuEA<C, M>(n, fmt);
-            (void)readFpuOpEa<C, M>(n, ea, fmt);
+            src = readFpuOpEa<C, M>(n, ea, fmt);
 
         } else {
 
-            (void)readFpuOp<C, M>(n, fmt);
+            src = readFpuOp<C, M>(n, fmt);
         }
     }
 
+    /* The FPSP reads the operands from the state frame of a following FSAVE
+     * (MC68040UM 9.6.1 and Table 9-16): the command word, the source operand
+     * converted to extended precision, the destination operand and their tags.
+     */
+    const MFloat80 &dst = fpu.fpr[(ext >> 7) & 7];
+    fpu.unimp.valid = true;
+    fpu.unimp.cmdreg1b = ext;
+    fpu.unimp.etemp = src;
+    fpu.unimp.stag = FPU::tag040(src);
+    fpu.unimp.fptemp = dst;
+    fpu.unimp.dtag = FPU::tag040(dst);
+    fpu.resetState = false;
+
     execException<C>(M68kException::FPU_UNIMPLEMENTED, int(ea));
 }
 
