From 2c41e29d7c03f2e3d6b5ba8ca1f05f5a1876a664 Mon Sep 17 00:00:00 2001
From: VERHILLE Arnaud <gist974@gmail.com>
Date: Wed, 25 Nov 2026 18:00:00 +0400
Subject: [PATCH 16/16] 68881/68882: an FMOVE to memory or to a data register
 takes a mid-instruction exception

MC68881/MC68882UM 6.1: "FPCP instruction exceptions that arise from the
move floating-point data register to external destination instructions
are reported to the MPU as mid-instruction exceptions", and "a take
mid-instruction exception primitive is issued after the operand is stored
in memory"; 6.1.3: the destination "is written as if the trap were
disabled, and then a take exception primitive is returned". The core
stored the operand, recorded the exception and took it as a
pre-instruction exception when the next FPU instruction started.

execFMove now takes it right after the store, and writeStackFrame1001()
writes the ten-word frame of MC68881/MC68882UM 7.4.2.6 (Figure 7-16) and
MC68030UM 10.4.19 (Figure 10-43): the scan PC (the address of the next
instruction) at +2, the address of the F-line operation word at +8, an
internal register at +C, the operation word at +E and the effective
address of the destination at +10 (undefined for a data register).

RTE needs no change: it reloads the program counter from +2, the scan PC.
The processor reads the response CIR (MC68030UM 8.1.13); the FPU has
completed the move before it requests the exception and answers with a
null primitive (MC68881/MC68882UM 6.1.13), which ends the instruction, and
the processor continues at the scan PC (MC68030UM 10.4.1).

The MC68882 does not clear the exception on the acknowledge
(MC68881/MC68882UM 6.1.13, 6.4.2.2); as before, the core takes it once
on both FPUs. The 68040 path (format 3) is unchanged.
---
 Moira/MoiraExceptions.h     | 12 ++++++++----
 Moira/MoiraExceptions_cpp.h | 27 +++++++++++++++++++++++++--
 Moira/MoiraExecFPU_cpp.h    | 13 +++++++++++--
 3 files changed, 44 insertions(+), 8 deletions(-)

diff --git a/Moira/MoiraExceptions.h b/Moira/MoiraExceptions.h
index f59f142..0e5c795 100644
--- a/Moira/MoiraExceptions.h
+++ b/Moira/MoiraExceptions.h
@@ -26,7 +26,7 @@ template <Core C> void writeStackFrame0010(u16 sr, u32 pc, u32 ia, u16 nr);
 template <Core C> void writeStackFrame0011(u16 sr, u32 pc, u32 ea, u16 nr);
 template <Core C> void writeStackFrame0111(u16 sr, u32 pc, u16 nr, u16 ssw, u32 addr, u32 dataOut);
 template <Core C> void writeStackFrame1000(StackFrame &frame, u16 sr, u32 pc, u32 ia, u16 nr, u32 addr);
-template <Core C> void writeStackFrame1001(u16 sr, u32 pc, u32 ia, u16 nr);
+template <Core C> void writeStackFrame1001(u16 sr, u32 pc, u32 ia, u16 nr, u16 op, u32 ea);
 template <Core C> void writeStackFrame1010(u16 sr, u32 pc, u16 nr, u16 ssw = 0, u32 addr = 0, u32 dataOut = 0, u16 stageC = 0, u16 stageB = 0);
 template <Core C> void writeStackFrame1011UAE(u16 sr, u16 nr, u32 pc, u16 ssw, u32 addr, u32 end, bool write, u32 dataOut);
 template <Core C> void writeStackFrame1011(u16 sr, u32 pc, u32 ia, u16 nr, u16 ssw = 0, u32 addr = 0, u32 dataOut = 0, u16 stageC = 0, u16 stageB = 0);
@@ -41,9 +41,13 @@ template <Core C, Mode M> void execFUnimplemented(int n, FpuFormat fmt, bool rm)
 
 // Raises a floating-point arithmetic exception (vectors 48 - 54). A pre-instruction
 // exception is taken before an FPU instruction starts and stacks its address
-// (format 0). A post-instruction exception (68040, FMOVE to memory) is taken
-// after the instruction and stacks the address of the next instruction and the
-// effective address (format 3).
+// (format 0). An exception of an FMOVE to memory or to a data register is taken
+// after the operand has been stored. The 68040 takes it as a post-instruction
+// exception and stacks the address of the next instruction and the effective
+// address (format 3). The 68881 and 68882 report it as a mid-instruction
+// exception: the stack frame holds the scan PC (the address of the next
+// instruction) where the other frames hold the program counter, the address of
+// the instruction, the operation word and the effective address (format 9).
 template <Core C> void execFpuTrap(u16 vector, bool post = false, u32 ea = 0);
 
 // Takes a pending floating-point arithmetic exception (returns false if none is pending)
diff --git a/Moira/MoiraExceptions_cpp.h b/Moira/MoiraExceptions_cpp.h
index 4d1983c..59a69d5 100644
--- a/Moira/MoiraExceptions_cpp.h
+++ b/Moira/MoiraExceptions_cpp.h
@@ -225,9 +225,30 @@ Moira::writeStackFrame1000(StackFrame &frame, u16 sr, u32 pc, u32 ia, u16 nr, u3
 }
 
 template <Core C> void
-Moira::writeStackFrame1001(u16 sr, u32 pc, u32 ia, u16 nr)
+Moira::writeStackFrame1001(u16 sr, u32 pc, u32 ia, u16 nr, u16 op, u32 ea)
 {
+    assert(C == Core::C68020);
+
+    // Effective address
+    push<C, Long>(ea);
+
+    // Operation word
+    push<C, Word>(op);
+
+    // Internal register
+    push<C, Word>(0);
 
+    // Program counter (address of the operation word)
+    push<C, Long>(ia);
+
+    // 1001 | Vector offset
+    push<C, Word>(0x9000 | nr << 2);
+
+    // Scan PC (next word to be fetched)
+    push<C, Long>(pc);
+
+    // Status register
+    push<C, Word>(sr);
 }
 
 template <Core C> void
@@ -762,8 +783,10 @@ Moira::execFpuTrap(u16 vector, bool post, u32 ea)
     clearTraceFlags();
 
     // Write stack frame
-    if (post) {
+    if (post && hasInternalFPU()) {
         writeStackFrame0011<C>(status, reg.pc, ea, vector);
+    } else if (post) {
+        writeStackFrame1001<C>(status, reg.pc, reg.pc0, vector, queue.ird, ea);
     } else {
         writeStackFrame0000<C>(status, reg.pc0, vector);
     }
diff --git a/Moira/MoiraExecFPU_cpp.h b/Moira/MoiraExecFPU_cpp.h
index 6957f9f..3608851 100644
--- a/Moira/MoiraExecFPU_cpp.h
+++ b/Moira/MoiraExecFPU_cpp.h
@@ -923,8 +923,7 @@ Moira::execFMove(u16 opcode)
     if (cod == 0b011) {
 
         // The 68040 takes an enabled exception right after a move to memory or to
-        // a data register (post-instruction exception). The 68881 and 68882 report
-        // it when the next FPU instruction starts, like all other exceptions.
+        // a data register (post-instruction exception).
         // On the 68040, a move to a byte, word or long word that raises SNAN or
         // OPERR takes the exception even if it is disabled (MC68040UM 9.7.2.2,
         // 9.7.3.2: a nonmaskable post-instruction exception, taken immediately).
@@ -938,6 +937,16 @@ Moira::execFMove(u16 opcode)
             FINALIZE
             return;
         }
+
+        // The 68881 and 68882 store the operand, too, and then report the exception
+        // as a mid-instruction exception (MC68881/MC68882UM 6.1, 6.1.3, 7.4.2.6). The
+        // effective address in the stack frame is undefined for a data register.
+        if (auto vector = fpu.trapVector(); vector && hasExternalFPU()) {
+
+            execFpuTrap<C>(vector, true, ea);
+            FINALIZE
+            return;
+        }
         fpu.pendingTrap = fpu.trapVector();
 
     } else {
