From deac81c7ae3c86093c4a541ec156ec8357eaa087 Mon Sep 17 00:00:00 2001
From: VERHILLE Arnaud <gist974@gmail.com>
Date: Wed, 25 Nov 2026 03:34:08 +0400
Subject: [PATCH 08/17] 68040: FSAVE stores the unimplemented instruction state
 frame

After an unimplemented floating-point instruction, the 68040 takes vector
11, and the handler executes FSAVE to get the instruction and its
operands. MC68040UM 9.6.1: "When the exception handler for unimplemented
floating-point instructions executes an FSAVE, a 26-word unimplemented
instruction state frame is created." FSAVE wrote a null frame instead if
no FPU instruction had run since reset, and a four-byte idle frame
otherwise. The M68040FPSP then took a format error, or read the
instruction and its operands from stack memory that FSAVE never wrote.

execFUnimplemented() now builds the frame of Figure 9-10 d with the
fields Table 9-16 lists: CMDREG1B, the source operand converted to
extended precision (ETEMP), the destination register (FPTEMP), their
tags (STAG, DTAG; encodings in 9.8), and T = 0. A packed decimal source
is not converted. Its bits 63-0 go to ETEMP, its bits 95-64 to the low
longword of FPTEMP, and E1 is set. Table 9-16 lists E1 as "always 1",
but the definition of E1 in 9.8 says that in this frame it flags a
packed source. The FPSP reads it that way: it unpacks the source
whenever E1 is set.

FSAVE leaves the FPU idle (M68000PRM, FSAVE), so a second FSAVE writes
an idle frame. FRESTORE of the frame loads it back. The frame is saved
only if the last instruction was unimplemented (MC68040UM 9.8). FRESTORE
of another frame, reset and the nonconditional FPU instructions discard
it. The 68040 busy and unimplemented frames carry version $41, like the
idle frame (Figure 9-10).
---
 Moira/FPU/FPU.cpp        | 16 ++++++++
 Moira/FPU/FPU.h          | 14 +++++++
 Moira/MoiraExecFPU_cpp.h | 80 ++++++++++++++++++++++++++++++++++++----
 3 files changed, 103 insertions(+), 7 deletions(-)

diff --git a/Moira/FPU/FPU.cpp b/Moira/FPU/FPU.cpp
index 26f9a8c..70a67e6 100644
--- a/Moira/FPU/FPU.cpp
+++ b/Moira/FPU/FPU.cpp
@@ -24,6 +24,7 @@ FPU::reset()
 
     resetState = true;
     pendingTrap = 0;
+    unimp.valid = false;
 }
 
 u16
@@ -956,6 +957,8 @@ FPU::computeFormatWord(FpuFrameType type) const
         case FpuFrameType::UNIMP:
         case FpuFrameType::BUSY:
 
+            // The 68040 frames carry the version number of the idle frame (MC68040UM Figure 9-10)
+            if (model == FPUModel::M68040) return 0x41000000 | u32(stateFrameSize(type)) << 16;
             return 0x1F000000 | u32(stateFrameSize(type)) << 16;
 
         default:
@@ -964,4 +967,17 @@ FPU::computeFormatWord(FpuFrameType type) const
     }
 }
 
+u32
+FPU::frameTag(const MFloat80 &value)
+{
+    /* 0 = normalized, 1 = zero, 2 = infinity, 3 = NaN,
+     * 4 = extended-precision denormalized or unnormalized (MC68040UM 9.8, STAG, DTAG)
+     */
+    if (value.isZero()) return 1;
+    if (value.isNaN()) return 3;
+    if (value.isInfinite()) return 2;
+    if (!value.integerBit()) return 4;
+    return 0;
+}
+
 }
diff --git a/Moira/FPU/FPU.h b/Moira/FPU/FPU.h
index 0c1ad9c..4f7d59a 100644
--- a/Moira/FPU/FPU.h
+++ b/Moira/FPU/FPU.h
@@ -134,6 +134,17 @@ public:
     /// Vector of an arithmetic exception that is taken when the next FPU instruction starts (0 = none)
     u16 pendingTrap = 0;
 
+    /// Instruction the 68040 left to the FPSP. FSAVE stores it in an unimplemented
+    /// instruction state frame, FRESTORE loads it back (MC68040UM 9.6.1, Figure 9-10).
+    /// The frame is saved if the last instruction was unimplemented (MC68040UM 9.8):
+    /// FSAVE and the nonconditional instructions discard it.
+    struct {
+
+        bool valid = false;     ///< Indicates whether FSAVE writes an UNIMP frame
+        u32 frame[12] = { };    ///< The frame without its format word
+
+    } unimp;
+
 
     //
     // Constructing
@@ -433,6 +444,9 @@ public:
 
     /// Computes a format word for a given frame type
     u32 computeFormatWord(FpuFrameType type) const;
+
+    /// Computes the tag of an operand in a 68040 state frame (STAG, DTAG)
+    static u32 frameTag(const MFloat80 &value);
 };
 
 }
diff --git a/Moira/MoiraExecFPU_cpp.h b/Moira/MoiraExecFPU_cpp.h
index fbff48a..b308de4 100644
--- a/Moira/MoiraExecFPU_cpp.h
+++ b/Moira/MoiraExecFPU_cpp.h
@@ -678,6 +678,12 @@ Moira::execFRestore(u16 opcode)
         u32 size = 4 + ((fmt >> 16) & 0xFF);
         fpu.resetState = false;
         fpu.pendingTrap = 0;
+
+        // An unimplemented instruction frame is loaded back, a following FSAVE stores it again
+        bool unimp = hasInternalFPU() && size == 4 + u32(fpu.stateFrameSize(FpuFrameType::UNIMP));
+        for (int i = 0; unimp && i < 12; i++) fpu.unimp.frame[i] = readM<C, M, Long>(U32_ADD(ea, 4 + 4 * i));
+        fpu.unimp.valid = unimp;
+
         if constexpr (M == Mode::PI) writeA(n, U32_ADD(ea, size));
     }
 
@@ -700,19 +706,25 @@ Moira::execFSave(u16 opcode)
     // The frame carries no exception state. A pending arithmetic exception is discarded (as in UAE).
     fpu.pendingTrap = 0;
 
-    // Frame to be written: A NULL frame if the FPU is in reset state, an IDLE frame otherwise
-    bool null = fpu.inResetState();
-    u32 fmt   = null ? 0 : fpu.computeFormatWord(FpuFrameType::IDLE);
-    u32 size  = null ? 4 : 4 + fpu.stateFrameSize(FpuFrameType::IDLE);
+    // Frame to be written: A NULL frame if the FPU is in reset state, an UNIMP frame
+    // after an instruction the 68040 left to the FPSP, an IDLE frame otherwise
+    bool null  = fpu.inResetState();
+    bool unimp = !null && fpu.unimp.valid;
+    auto type  = unimp ? FpuFrameType::UNIMP : FpuFrameType::IDLE;
+    u32 fmt    = null ? 0 : fpu.computeFormatWord(type);
+    u32 size   = null ? 4 : 4 + fpu.stateFrameSize(type);
 
     u32 ea;
     if constexpr (M == Mode::PD) ea = U32_SUB(readA(n), size); else ea = computeEA<C, M, Long>(n);
 
     writeM<C, M, Long>(ea, fmt);
-    for (u32 i = 4; i < size; i += 4) writeM<C, M, Long>(U32_ADD(ea, i), 0);
+    for (u32 i = 4; i < size; i += 4) writeM<C, M, Long>(U32_ADD(ea, i), unimp ? fpu.unimp.frame[i / 4 - 1] : 0);
 
     if constexpr (M == Mode::PD) writeA(n, ea);
 
+    // After the save, the FPU is idle (M68000PRM, FSAVE)
+    fpu.unimp.valid = false;
+
     prefetch<C, POLL>();
 
     FINALIZE
@@ -826,6 +838,7 @@ Moira::execFMove(u16 opcode)
     if (illegal) { execLineF<C, I, M, S>(opcode); return; }
 
     fpu.resetState = false;
+    fpu.unimp.valid = false;
     readI<C, Word>();
     fpu.clearExcStatusByte();
 
@@ -955,6 +968,7 @@ Moira::execFMovecr(u16 opcode)
     }
 
     fpu.resetState = false;
+    fpu.unimp.valid = false;
     readI<C, Word>();
     fpu.clearExcStatusByte();
 
@@ -993,6 +1007,7 @@ Moira::execFMovem(u16 opcode)
     if (!isValidExtFPU(I, M, opcode, ext, cpuModel)) { execLineF<C, I, M, S>(opcode); return; }
 
     fpu.resetState = false;
+    fpu.unimp.valid = false;
     readI<C, Word>();
 
     switch (cod) {
@@ -1127,6 +1142,10 @@ Moira::execFUnimplemented(int n, FpuFormat fmt, bool rm)
      * instruction and the effective address (0 for register operands, as in UAE).
      */
     u32 ea = 0;
+    u16 ext = queue.irc;
+    bool packed = rm && fmt == FpuFormat::PACKED;
+    MFloat80 src = fpu.fpr[(ext >> 10) & 7];
+    u32 w[3] = { };
 
     readI<C, Word>();
     fpu.setFPIAR(getPC0());
@@ -1136,14 +1155,60 @@ Moira::execFUnimplemented(int n, FpuFormat fmt, bool rm)
         if constexpr (isMemMode(M)) {
 
             ea = computeFpuEA<C, M>(n, fmt);
-            (void)readFpuOpEa<C, M>(n, ea, fmt);
+
+            if (packed) {
+
+                // The FPSP converts a packed decimal operand itself
+                w[0] = readM<C, M, Long>(ea);
+                w[1] = readM<C, M, Long>(U32_ADD(ea, 4));
+                w[2] = readM<C, M, Long>(U32_ADD(ea, 8));
+                updateAn<M, Extended>(n);
+
+            } else {
+
+                src = readFpuOpEa<C, M>(n, ea, fmt);
+            }
+
+        } else if (isImmMode(M) && packed) {
+
+            w[0] = readI<C, Long>();
+            w[1] = readI<C, Long>();
+            w[2] = readI<C, Long>();
 
         } else {
 
-            (void)readFpuOp<C, M>(n, fmt);
+            src = readFpuOp<C, M>(n, fmt);
         }
     }
 
+    /* The FPSP takes the instruction and its operands from the frame of a
+     * following FSAVE (MC68040UM 9.6.1, Table 9-16, Figure 9-10 d): the command
+     * word (CMDREG1B), the source operand converted to extended precision
+     * (ETEMP), the destination register (FPTEMP) and their tags. A packed
+     * decimal source stays unconverted: bits 63-0 are stored in ETEMP and bits
+     * 95-64 in the low longword of FPTEMP. E1 marks this case. Table 9-16 lists
+     * E1 as always set, but the definition of E1 (MC68040UM 9.8) and the FPSP
+     * (it unpacks the source if E1 is set) read it as the packed flag.
+     */
+    auto &dst = fpu.fpr[(ext >> 7) & 7];
+    auto &f = fpu.unimp.frame;
+
+    f[0]  = 0;                                                  // $04: CMDREG3B
+    f[1]  = 0;
+    f[2]  = packed ? 0 : FPU::frameTag(src) << 29;              // $0C: STAG
+    f[3]  = u32(ext) << 16;                                     // $10: CMDREG1B
+    f[4]  = FPU::frameTag(dst) << 29;                           // $14: DTAG
+    f[5]  = packed ? 1 << 26 : 0;                               // $18: E1, T = 0
+    f[6]  = packed ? 0 : u32(dst.signExp()) << 16;              // $1C: FPTEMP
+    f[7]  = packed ? 0 : u32(dst.mantissa() >> 32);
+    f[8]  = packed ? w[0] : u32(dst.mantissa());
+    f[9]  = packed ? 0 : u32(src.signExp()) << 16;              // $28: ETEMP
+    f[10] = packed ? w[1] : u32(src.mantissa() >> 32);
+    f[11] = packed ? w[2] : u32(src.mantissa());
+
+    fpu.unimp.valid = true;
+    fpu.resetState = false;
+
     execException<C>(M68kException::FPU_UNIMPLEMENTED, int(ea));
 }
 
@@ -1186,6 +1251,7 @@ Moira::execFGeneric(u16 opcode)
     }
 
     fpu.resetState = false;
+    fpu.unimp.valid = false;
     readI<C, Word>();
     fpu.clearExcStatusByte();
 
