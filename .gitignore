# Build trees
build/
# Both spellings: every other build dir in this file uses a hyphen
# (build-pgo, build-release, build-appimage...), so `build_wasm` alone
# with an underscore let an `emcmake cmake -B build-wasm` tree — 7.9 MB
# of .wasm — sit untracked-but-not-ignored, one `git add -A` from a commit.
build_wasm/
build-wasm/
# Dear ImGui is fetched by setup_imgui.sh, not vendored
imgui/
disks35/
hdv/
*.vhd
docs/*.zip
docs/*ROMs/
roms/
*.dsk
*.img
*.hdv
# Large user-fetched test corpora (tests/fetch_sst_68000.sh)
tests/data/
# User-provided game/CD images (never committed — GitHub 100MB limit)
input/
# Editor/tooling
.cache/
compile_commands.json
*.ppm
*.png
*.pbm
# …except the packaged application icon: both packagers read it from the
# checkout (AppImage hicolor icon, macOS .icns via sips), and *.png above
# silently kept it out of the repo until the first release run.
!packaging/POM68K.png
# q605_trace debug artifacts (VRAM snapshot + PRAM dump)
q605_vram.raw
q605_trace.pram
# Any runtime PRAM/battery dump (trace + boot-etalon artifacts)
*.pram
# AppleShare export dir: the AFP server's runtime share (user disks/games,
# .AppleDouble sidecars, Network Trash Folder) — user data, never source
AppleShare/

# Sound capture artifacts (sound_test)
*.wav
# ...but the MAME mechanical-sound sample set IS source (BSD-3, committed)
!assets/floppy_samples/*.wav

# Build/debug/run artifacts (not source)
gdb.out
*.pid
imgui.ini
Testing/
build-oracle-uae/
scratchpad/__pycache__/
.venv-tools/

# netatalk 2 vendored SOURCE lives in extern/netatalk2 (committed);
# only its build tree and fetched static deps are ignored
extern/netatalk2-build/
tools/netatalk2/run/
# Python bytecode (router.py runs the vendored tashrouter in-place)
extern/tashrouter/**/__pycache__/
# SCC wire-debug log (SCCDBG); regenerated at runtime
scc.log

# Old agent debug artefacts and the PGO build tree (regenerable)
debug/
build-pgo/

# Release packaging outputs (regenerable; see .github/workflows/release.yml)
dist/
build-release/
build-appimage/
build-universal-deps/

# Guest-side dev apps (dev/): SOURCES are committed — the Retro68
# toolchain (user-built, ~11 GB, see dev/README.md) and the app build
# trees are not (dev/*/build/ is already caught by the global build/
# rule; the two toolchain trees need naming)
dev/Retro68/
dev/Retro68-build/
