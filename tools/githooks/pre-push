#!/bin/sh
# POM68K — green CI is a push condition (DEV.md § quick start).
#
# Ten days of red CI buried two real regressions (CHANGELOG 2026-09-02
# (tenth)). This hook turns red into a same-day discovery: the last
# COMPLETED run of each required workflow on main must have concluded
# `success` before a push leaves this machine.
#
# The push that repairs red is the one push this gate must not stop
# (CHANGELOG 2026-10-25). A commit in the pushed range that carries a
# `CI-Fix: <run-id>` trailer naming the red run of a workflow clears that
# workflow; every red workflow must be named. The trailer is checked
# against the live run id, so it cannot clear a red it did not cite.
# A conscious bypass remains `git push --no-verify` — and the red becomes
# the day's first task.
#
# Unknown is not red: without `gh`, or offline, or before a workflow's
# first run, the push proceeds with a warning. The gate blocks on known
# failure only, so it can never strand a laptop that cannot ask.
#
# Install (versioned, once per clone):  git config core.hooksPath tools/githooks

command -v gh >/dev/null 2>&1 || {
    echo "[pre-push] gh not found — CI status unknown, push allowed" >&2
    exit 0
}

# Git feeds "<local ref> <local sha> <remote ref> <remote sha>" per ref.
zero=0000000000000000000000000000000000000000
fixes=""
while read -r _lref lsha _rref rsha; do
    [ "$lsha" = "$zero" ] && continue           # branch deletion
    if [ "$rsha" = "$zero" ]; then
        range="$lsha --not --remotes"
    else
        range="$rsha..$lsha"
    fi
    # shellcheck disable=SC2086
    fixes="$fixes $(git log --format='%(trailers:key=CI-Fix,valueonly)' $range 2>/dev/null)"
done

fail=0
for wf in CI macOS Nightly; do
    run=$(gh run list --workflow "$wf" --branch main --status completed \
              --limit 1 --json conclusion,databaseId \
              --jq '.[0] | "\(.conclusion) \(.databaseId)"' 2>/dev/null)
    st=${run% *}
    id=${run#* }
    [ "$st" = null ] && st=""                   # no run yet: unknown, not red
    case "$st" in
        "")
            echo "[pre-push] $wf: no completed run visible — push allowed" >&2
            ;;
        success)
            ;;
        *)
            case " $(echo $fixes) " in
                *" $id "*)
                    echo "[pre-push] $wf: run $id concluded '$st'; pushed commits carry CI-Fix: $id" >&2
                    ;;
                *)
                    echo "[pre-push] $wf: last completed run on main concluded '$st' (run $id)" >&2
                    fail=1
                    ;;
            esac
            ;;
    esac
done

if [ "$fail" = 1 ]; then
    echo "[pre-push] red is a discovery, not a queue: fix it today and mark the" >&2
    echo "[pre-push] fixing commit with a \`CI-Fix: <run-id>\` trailer per red run," >&2
    echo "[pre-push] or bypass consciously with \`git push --no-verify\`." >&2
    exit 1
fi
exit 0
