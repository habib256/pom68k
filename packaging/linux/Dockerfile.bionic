# Dockerfile.bionic — the FROZEN POM68K Linux release toolchain (x86_64 AND
# aarch64: ubuntu:18.04 is a multi-arch base and every RUN below detects the
# architecture it is building for).
#
# WHY THIS EXISTS (inherited from POM1, packaging/linux/Dockerfile.bionic
# there): the Linux AppImage must link against glibc 2.27 so it runs on
# Mint 19.x-era distros and everything newer — an AppImage never bundles
# glibc, so its floor == the build image's glibc. Bionic is EOL and its apt
# mirrors are flaky, so the whole toolchain is baked ONCE into a pinned GHCR
# image; a release then just `docker run`s it (packaging/linux/
# build_in_bionic.sh), immune to mirror outages and reproducible by digest.
#
# POM68K divergence from POM1's image: the tree is C++20 (Moira), so the
# compiler is g++-11 from ubuntu-toolchain-r/test (g++-10 fallback), not
# g++-9 — and there is no cc65/python layer, POM68K bundles no toolchain.
#
# Build + push via .github/workflows/build-bionic-image.yml (one native job
# per arch — no QEMU). Pin by digest in release.yml.
FROM ubuntu:18.04

SHELL ["/bin/bash", "-euxo", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

# Pinned toolchain inputs. CMake is checksum-verified per arch; the AppImage
# tools are pinned by release tag (SHAs differ per arch and upstream does not
# publish a manifest — the image digest is the reproducibility anchor here).
ARG CMAKE_VER=3.27.9
ARG CMAKE_SHA256_X86_64=72b01478eeb312bf1a0136208957784fe55a7b587f8d9f9142a7fc9b0b9e9a28
ARG CMAKE_SHA256_AARCH64=11bf3d30697df465cdf43664a9473a586f010c528376a966fd310a3a22082461
ARG GLFW_VER=3.3.10
ARG GLFW_SHA256=4ff18a3377da465386374d8127e7b7349b685288cb8e17122f7e1179f73769d5

# --- base tooling + X11/GL dev headers ---------------------------------------
# bionic's apt archives flip between archive.ubuntu.com and old-releases (and
# ports.ubuntu.com on arm64). Retry the configured mirror; fall back to
# old-releases only when it truly gives up. This bites only at image-build
# time, never per release.
RUN apt_update_retry() { local i; for i in 1 2 3 4; do apt-get update && return 0; echo "[apt] update attempt $i/4 failed; retrying in 15s" >&2; sleep 15; done; return 1; }; \
    if ! apt_update_retry; then \
        echo "[apt] configured mirror unreachable — falling back to old-releases" >&2; \
        sed -i -e 's|http://archive.ubuntu.com/ubuntu|http://old-releases.ubuntu.com/ubuntu|g' \
               -e 's|http://security.ubuntu.com/ubuntu|http://old-releases.ubuntu.com/ubuntu|g' \
               -e 's|http://ports.ubuntu.com/ubuntu-ports|http://old-releases.ubuntu.com/ubuntu|g' \
               /etc/apt/sources.list; \
        apt_update_retry; \
    fi; \
    apt-get install -y --no-install-recommends \
        ca-certificates gnupg wget curl git make pkg-config \
        file desktop-file-utils xz-utils \
        build-essential software-properties-common \
        libgl1-mesa-dev \
        libx11-dev libxrandr-dev libxinerama-dev libxcursor-dev libxi-dev libxext-dev

# --- g++-11 (C++20 for Moira; bionic default is g++-7) -----------------------
# ubuntu-toolchain-r/test publishes bionic builds for amd64 AND arm64.
# g++-10 is the documented fallback: every C++20 construct the tree uses
# (std::rotr, map::contains, designated initializers) is complete there too.
RUN add-apt-repository -y ppa:ubuntu-toolchain-r/test && apt-get update && \
    if apt-get install -y --no-install-recommends gcc-11 g++-11; then GCCV=11; \
    else apt-get install -y --no-install-recommends gcc-10 g++-10; GCCV=10; fi && \
    update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-${GCCV} 90 \
                        --slave   /usr/bin/g++ g++ /usr/bin/g++-${GCCV} && \
    gcc --version

# --- modern CMake (bionic ships 3.10; repo needs >= 3.16) --------------------
RUN ARCH="$(uname -m)"; \
    case "${ARCH}" in \
        x86_64)  SHA="${CMAKE_SHA256_X86_64}";  TARBALL="cmake-${CMAKE_VER}-linux-x86_64.tar.gz"  ;; \
        aarch64) SHA="${CMAKE_SHA256_AARCH64}"; TARBALL="cmake-${CMAKE_VER}-linux-aarch64.tar.gz" ;; \
        *) echo "unsupported arch ${ARCH}" >&2; exit 1 ;; \
    esac; \
    wget -qO /tmp/cmake.tar.gz \
        "https://github.com/Kitware/CMake/releases/download/v${CMAKE_VER}/${TARBALL}" && \
    echo "${SHA}  /tmp/cmake.tar.gz" | sha256sum -c - && \
    mkdir -p /opt/cmake && tar --strip-components=1 -xzf /tmp/cmake.tar.gz -C /opt/cmake && \
    rm -f /tmp/cmake.tar.gz
ENV PATH="/opt/cmake/bin:${PATH}"

# --- GLFW 3.3 from source → /usr/local (bionic libglfw3-dev is 3.2.1) --------
#     find_package(glfw3 3.3 CONFIG) resolves it; linuxdeploy bundles
#     libglfw.so.3 into the AppImage.
RUN wget -qO /tmp/glfw.tar.gz \
        "https://github.com/glfw/glfw/archive/refs/tags/${GLFW_VER}.tar.gz" && \
    echo "${GLFW_SHA256}  /tmp/glfw.tar.gz" | sha256sum -c - && \
    tar -xzf /tmp/glfw.tar.gz -C /tmp && \
    cmake -S "/tmp/glfw-${GLFW_VER}" -B /tmp/glfw-build \
        -DGLFW_BUILD_EXAMPLES=OFF -DGLFW_BUILD_TESTS=OFF -DGLFW_BUILD_DOCS=OFF \
        -DBUILD_SHARED_LIBS=ON -DCMAKE_INSTALL_PREFIX=/usr/local && \
    cmake --build /tmp/glfw-build -j"$(nproc)" --target install && ldconfig && \
    rm -rf /tmp/glfw.tar.gz "/tmp/glfw-${GLFW_VER}" /tmp/glfw-build

# --- AppImage tooling, extracted → /opt/appimage-tools (no FUSE needed) ------
#     appimagetool from AppImageKit (the OLD repo): its x86_64 runtime is
#     ELF ET_EXEC + gzip squashfs, which AppImageLauncher accepts; the NEW
#     AppImage/appimagetool ships a static-pie ET_DYN runtime rejected as
#     "type -1". On aarch64 even AppImageKit's `continuous` runtime is
#     ET_DYN — release 12 is the last ET_EXEC aarch64 runtime, so it is
#     baked here and passed via --runtime-file (the POM1 lesson,
#     packaging/linux/build_appimage.sh there, 2026-07-25).
RUN ARCH="$(uname -m)"; mkdir -p /opt/appimage-tools && cd /opt/appimage-tools && \
    wget -q "https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-${ARCH}.AppImage" -O linuxdeploy.AppImage && \
    wget -q "https://github.com/AppImage/AppImageKit/releases/download/continuous/appimagetool-${ARCH}.AppImage" -O appimagetool.AppImage && \
    chmod +x ./*.AppImage && \
    ./linuxdeploy.AppImage  --appimage-extract >/dev/null && mv squashfs-root linuxdeploy.AppDir && \
    ./appimagetool.AppImage --appimage-extract >/dev/null && mv squashfs-root appimagetool.AppDir && \
    rm -f ./*.AppImage && \
    if [ "${ARCH}" = "aarch64" ]; then \
        wget -q "https://github.com/AppImage/AppImageKit/releases/download/12/runtime-aarch64" \
             -O runtime-aarch64-et_exec; \
    fi
ENV POM68K_APPIMAGE_TOOLS_DIR=/opt/appimage-tools

WORKDIR /work
