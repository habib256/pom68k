<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- POM68K — Windows application manifest. activeCodePage UTF-8 makes the
     CRT's narrow argv and every ANSI API UTF-8 (Windows 10 1903+), which is
     what SessionFile's pathFromUtf8 and the ROM/media paths assume. Without
     it, a non-ASCII session path ended the process before main's first line
     (gui_session_smoke_test, exit 127 on the MSVC runner, CHANGELOG
     2026-10-13). -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
