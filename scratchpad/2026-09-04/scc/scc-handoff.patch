 void Q605Memory::flushScc() {
+    // The single door to the chip: every SCC MMIO access and the public
+    // scc() accessor call this before touching it, so dropping the
+    // published deadline here covers every mutation that could move it —
+    // a register write, an ext/status ack, an injected Rx frame, a wire
+    // pacing change. Only tick() republishes.
+    sccNextFromTickValid_ = false;
     // Normally bounded by cyclesToNextEvent(). Chunking also makes a long
     // idle snapshot safe: an SCC with no armed event may accumulate more
     // than tick(int) can represent before a later MMIO/wire access.
