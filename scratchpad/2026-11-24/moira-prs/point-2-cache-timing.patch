From 5a836cc6696b4619356d1485aca5756a2a78b887 Mon Sep 17 00:00:00 2001
From: VERHILLE Arnaud <gist974@gmail.com>
Date: Tue, 24 Nov 2026 06:54:42 +0400
Subject: [PATCH] 68020/68030: account for instruction cache fills in the cycle
 budget

---
 Moira/MoiraDataflow_cpp.h   |  7 ++++++-
 Tests/Unit/MmuExecTests.cpp | 32 ++++++++++++++++++++++++++++++++
 2 files changed, 38 insertions(+), 1 deletion(-)

diff --git a/Moira/MoiraDataflow_cpp.h b/Moira/MoiraDataflow_cpp.h
index 8cd25c4..7fa1440 100644
--- a/Moira/MoiraDataflow_cpp.h
+++ b/Moira/MoiraDataflow_cpp.h
@@ -884,7 +884,12 @@ Moira::readInstr(u32 addr)
             completeBusError<Word, false>(e);
             throw;
         }
-        budget.penalty += busAccess ? (portSize(dsack(phys)) == 4 ? 0 : 4) : -2;
+        // The 020/030 instruction timings already include a cached fetch.
+        // Charge the cache fill on a miss, plus the existing narrow-port penalty.
+        if (busAccess) {
+            if (iCache.emulated) budget.penalty += 2;
+            if (portSize(dsack(phys)) != 4) budget.penalty += 4;
+        }
 
         return result;
 
diff --git a/Tests/Unit/MmuExecTests.cpp b/Tests/Unit/MmuExecTests.cpp
index 203596f..adc7f32 100644
--- a/Tests/Unit/MmuExecTests.cpp
+++ b/Tests/Unit/MmuExecTests.cpp
@@ -1365,6 +1365,38 @@ TEST_CASE("Peek (68040)")
     }
 }
 
+TEST_CASE("Instruction cache hits keep the 68020 table timing")
+{
+    for (auto model : { CPUModel::M68020, CPUModel::M68030 }) {
+        for (bool cached : { false, true }) {
+            CAPTURE(int(model));
+            CAPTURE(cached);
+            TestCPU cpu(model);
+            cpu.portDsack = DSACK_32;
+            cpu.setCACR(cached ? CACR::E : 0);
+            cpu.setD(0, 200);
+
+            // Put the loop in the region where TestCPU counts host bus reads.
+            for (int i = 0; i < 8; i++) cpu.write16(dataBase + 2 * i, 0x4E71);
+            cpu.write16(dataBase + 16, 0x51C8);  // DBF D0,loop
+            cpu.write16(dataBase + 18, 0xFFEE);
+            cpu.jump(dataBase);
+            for (int i = 0; i < 9; i++) cpu.execute();
+            REQUIRE(cpu.getPC0() == dataBase);
+
+            cpu.longReads.clear();
+            auto start = cpu.getClock();
+            for (int i = 0; i < 100 * 9; i++) cpu.execute();
+            REQUIRE(cpu.getPC0() == dataBase);
+            CHECK(cpu.getD(0) == 99);
+            // MC68020UM 8.2.15-16: eight NOPs at 2 clocks, taken DBF at 6.
+            // With the cache disabled this aligned loop fills five longwords.
+            CHECK(cpu.longReads.size() == (cached ? 0 : 100 * 5));
+            CHECK(cpu.getClock() - start == 100 * (8 * 2 + 6 + (cached ? 0 : 5 * 2)));
+        }
+    }
+}
+
 TEST_SUITE_END();
 
 }
