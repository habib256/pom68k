# Two product profiles share the Jaws/M50753 board and private firmware.
add_test(NAME pb170_boot_etalon COMMAND pb140_boot_etalon --pb170)
add_test(NAME interp_pb170_boot_etalon COMMAND pb140_boot_etalon --pb170)
set_tests_properties(pb170_boot_etalon interp_pb170_boot_etalon PROPERTIES WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR})
set_tests_properties(interp_pb170_boot_etalon PROPERTIES ENVIRONMENT "POM68K_CPU_ENGINE=interp")
add_executable(pb030_product_test tests/pb030_product_test.cpp)
target_link_libraries(pb030_product_test PRIVATE pom68k_core)
add_test(NAME pb030_product_test COMMAND pb030_product_test)
foreach(model pb140 pb170)
    add_test(NAME ${model}_agent_boot_etalon COMMAND pb140_boot_etalon --${model})
    set_tests_properties(${model}_agent_boot_etalon PROPERTIES ENVIRONMENT "POM68K_TEST_AGENT=1" TIMEOUT 1800 WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR})
endforeach()
